// Control flow graph for Check.get_status (hc/api/models.py:355-380).
// Rebuild the PNG with:
//   "C:\Program Files\Graphviz\bin\dot.exe" -Tpng evidence/cfg-get-status.dot -o evidence/cfg-get-status.png
// Node count N = 18, edge count E = 24, connected components P = 1.
// V(G) = E - N + 2P = 24 - 18 + 2 = 8. Decisions + 1 = 7 + 1 = 8.
digraph CFG_get_status {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=10];
    edge [fontname="Helvetica", fontsize=9];

    n1  [shape=box,    label="1: frozen_now = now()"];
    n2  [shape=diamond,label="2: if self.last_start"];
    n3  [shape=diamond,label="3: if frozen_now >=\nlast_start + grace"];
    n4  [shape=box,    label="4: return \"down\""];
    n5  [shape=diamond,label="5: elif with_started"];
    n6  [shape=box,    label="6: return \"started\""];
    n7  [shape=diamond,label="7: if status in\n(new,paused,down)"];
    n8  [shape=box,    label="8: return self.status"];
    n9  [shape=box,    label="9: grace_start =\nget_grace_start(...)"];
    n10 [shape=diamond,label="10: if grace_start is None"];
    n11 [shape=box,    label="11: return \"up\""];
    n12 [shape=box,    label="12: grace_end =\ngrace_start + grace"];
    n13 [shape=diamond,label="13: if frozen_now >=\ngrace_end"];
    n14 [shape=box,    label="14: return \"down\""];
    n15 [shape=diamond,label="15: if frozen_now >=\ngrace_start"];
    n16 [shape=box,    label="16: return \"grace\""];
    n17 [shape=box,    label="17: return \"up\""];
    n18 [shape=oval,   label="18: EXIT"];

    n1  -> n2;
    n2  -> n3  [label="T"];
    n2  -> n7  [label="F"];
    n3  -> n4  [label="T"];
    n3  -> n5  [label="F"];
    n5  -> n6  [label="T"];
    n5  -> n7  [label="F"];
    n7  -> n8  [label="T"];
    n7  -> n9  [label="F"];
    n9  -> n10;
    n10 -> n11 [label="T"];
    n10 -> n12 [label="F"];
    n12 -> n13;
    n13 -> n14 [label="T"];
    n13 -> n15 [label="F"];
    n15 -> n16 [label="T"];
    n15 -> n17 [label="F"];
    n4  -> n18;
    n6  -> n18;
    n8  -> n18;
    n11 -> n18;
    n14 -> n18;
    n16 -> n18;
    n17 -> n18;
}
